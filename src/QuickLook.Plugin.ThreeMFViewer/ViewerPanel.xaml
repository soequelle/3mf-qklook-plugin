<UserControl x:Class="QuickLook.Plugin.ThreeMFViewer.ViewerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayBox" TargetType="Border">
            <Setter Property="Background" Value="#A0202020" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The border receives the mouse; the viewport itself is not hit-testable. -->
        <Border x:Name="viewportHost"
                Background="Transparent"
                ClipToBounds="True"
                Visibility="Collapsed">
            <Viewport3D x:Name="viewport" IsHitTestVisible="False">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="camera" FieldOfView="40" />
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight Color="#FF464646" />
                            <DirectionalLight x:Name="headlight" Color="#FF9C9C9C" Direction="0,0,-1" />
                            <DirectionalLight Color="#FF2C2C2C" Direction="0.4,0.6,-1" />
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <ModelVisual3D x:Name="modelVisual" />
            </Viewport3D>
        </Border>

        <Image x:Name="imageView"
               Margin="24,16,24,56"
               RenderOptions.BitmapScalingMode="HighQuality"
               Stretch="Uniform"
               StretchDirection="Both"
               Visibility="Collapsed" />

        <TextBlock x:Name="statusText"
                   Margin="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="#FF8C8C8C"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <Border x:Name="modeSwitch"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource OverlayBox}"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="modelButton" Click="ModelButton_Click" Style="{StaticResource OverlayButton}" />
                <Button x:Name="imageButton" Click="ImageButton_Click" Style="{StaticResource OverlayButton}" />
            </StackPanel>
        </Border>

        <Border x:Name="plateNav"
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Style="{StaticResource OverlayBox}"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="previousPlate" Click="PreviousPlate_Click" Content="‹" FontSize="14" Padding="10,2,10,4" Style="{StaticResource OverlayButton}" />
                <TextBlock x:Name="plateText" Margin="6,0" VerticalAlignment="Center" FontSize="12" Foreground="White" />
                <Button x:Name="nextPlate" Click="NextPlate_Click" Content="›" FontSize="14" Padding="10,2,10,4" Style="{StaticResource OverlayButton}" />
            </StackPanel>
        </Border>

        <Border x:Name="infoBar"
                Margin="10,0,0,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                Style="{StaticResource OverlayBox}"
                Visibility="Collapsed">
            <TextBlock x:Name="infoText" Margin="8,3" FontSize="11.5" Foreground="White" TextWrapping="Wrap" MaxWidth="560" />
        </Border>
    </Grid>
</UserControl>
